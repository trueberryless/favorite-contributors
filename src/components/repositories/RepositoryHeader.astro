---
export interface Props {
  organisationName: string;
  organisationUrl?: string;
  repositoryName: string;
  lastUpdated: string | null;
  totalContributors: number;
}

const { organisationName, organisationUrl, repositoryName, lastUpdated, totalContributors } = Astro.props;
---

<header class="repository-header fade-in">
  <div class="repository-identity">
    {organisationUrl ? (
      <a href={organisationUrl} class="image-link">
        <img src={`https://github.com/${organisationName}.png?size=240`} alt={organisationName} />
      </a>
    ) : (
      <img src={`https://github.com/${organisationName}.png?size=240`} alt={organisationName} />
    )}
    <div class="repository-titles">
      <h1>
        {organisationUrl ? (
          <a href={organisationUrl} class="text-link">{organisationName}</a>
        ) : (
          organisationName
        )} / <span class="highlight">{repositoryName}</span>
      </h1>
      <div class="badges">
        <span class="badge stats-badge">{totalContributors} Contributors</span>
        {lastUpdated && (
          <span class="badge date-badge">Updated: {new Date(lastUpdated).toLocaleDateString()}</span>
        )}
      </div>
    </div>
  </div>
</header>

<style>
  .repository-header {
    margin-bottom: 3rem;
  }
  .repository-identity {
    display: flex;
    align-items: center;
    gap: 2rem;
  }
  .image-link {
    display: contents;
  }
  .text-link {
    color: inherit;
    text-decoration: none;
  }
  .repository-identity img {
    width: 120px;
    height: 120px;
    border-radius: 1rem;
    object-fit: cover;
    border: 3px solid var(--card-border);
    background: var(--card-bg);
  }
  .repository-titles h1 {
    font-size: 2.5rem;
    font-weight: 800;
    margin: 0 0 0.75rem 0;
    color: var(--text-muted);
    letter-spacing: -0.02em;
  }
  .repository-titles .highlight {
    color: var(--text-color);
  }
  .badges {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .badge {
    background: var(--tag-bg);
    color: var(--accent-color);
    padding: 0.35rem 0.75rem;
    border-radius: 0.375rem;
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .badge.date-badge {
    color: var(--text-muted);
    background: transparent;
    border: 1px solid var(--card-border);
  }
  @media (max-width: 768px) {
    .repository-identity {
      flex-direction: column;
      text-align: center;
      gap: 1.5rem;
    }
    .badges {
      justify-content: center;
    }
  }
</style>
