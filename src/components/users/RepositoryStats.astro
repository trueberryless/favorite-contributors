---
export interface Props {
  repoStats: Record<string, Record<string, {
    score: number;
    mergedPrs: number;
    reviews: number;
    reviewsReceived: number;
    issuesLinked: number;
    reactions: number;
  }>>;
}

const { repoStats } = Astro.props;
---

<section class="repo-section fade-in" style="animation-delay: 300ms;">
  <div class="section-heading">Repository Breakdown</div>
  <div class="repo-groups">
    {Object.entries(repoStats)
      .sort((a, b) => {
        const scoreA = Object.values(a[1]).reduce((acc, repo) => acc + repo.score, 0);
        const scoreB = Object.values(b[1]).reduce((acc, repo) => acc + repo.score, 0);
        return scoreB - scoreA;
      })
      .map(([org, repos]) => (
      <div class="org-repo-group">
        <h3 class="org-repo-title">{org}</h3>

        <div class="table-container desktop-only">
          <table>
            <thead>
              <tr>
                <th class="repo-name-col">Repository</th>
                <th>Score</th>
                <th>PRs</th>
                <th>Reviews</th>
                <th>Issues</th>
                <th>Reactions</th>
              </tr>
            </thead>
            <tbody>
              {Object.entries(repos)
                .sort((a, b) => b[1].score - a[1].score)
                .map(([repo, stat]) => (
                <tr class="repo-row">
                  <td class="repo-name-col">
                    <a href={`/repositories/${org}/${repo}`} class="repo-link">{repo}</a>
                  </td>
                  <td class="stat-highlight">{stat.score.toLocaleString()}</td>
                  <td>{stat.mergedPrs.toLocaleString()}</td>
                  <td>{stat.reviews.toLocaleString()}</td>
                  <td>{stat.issuesLinked.toLocaleString()}</td>
                  <td>{stat.reactions.toLocaleString()}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="accordion-container mobile-only">
          {Object.entries(repos)
            .sort((a, b) => b[1].score - a[1].score)
            .map(([repo, stat]) => (
            <details class="repo-accordion">
              <summary class="repo-summary">
                <span class="repo-name-mobile">{repo}</span>
                <span class="repo-score-mobile">{stat.score.toLocaleString()}</span>
                <svg class="accordion-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </summary>
              <div class="repo-details-wrapper">
                <div class="repo-details">
                  <div class="stat-grid">
                    <div class="stat-item">
                      <span class="stat-label">PRs</span>
                      <span class="stat-value">{stat.mergedPrs.toLocaleString()}</span>
                    </div>
                    <div class="stat-item">
                      <span class="stat-label">Reviews</span>
                      <span class="stat-value">{stat.reviews.toLocaleString()}</span>
                    </div>
                    <div class="stat-item">
                      <span class="stat-label">Issues</span>
                      <span class="stat-value">{stat.issuesLinked.toLocaleString()}</span>
                    </div>
                    <div class="stat-item">
                      <span class="stat-label">Reactions</span>
                      <span class="stat-value">{stat.reactions.toLocaleString()}</span>
                    </div>
                  </div>
                  <a href={`/repositories/${org}/${repo}`} class="repo-action-button">Go to repo page</a>
                </div>
              </div>
            </details>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<script>
  if (typeof window !== 'undefined') {
    document.querySelectorAll('.repo-accordion').forEach(details => {
      const summary = details.querySelector('.repo-summary');
      const content = details.querySelector('.repo-details-wrapper') as HTMLElement;
      let isAnimating = false;

      if (summary && content) {
        summary.addEventListener('click', (e) => {
          e.preventDefault();
          if (isAnimating) return;
          isAnimating = true;

          if (details.hasAttribute('open')) {
            content.style.height = `${content.offsetHeight}px`;
            content.offsetHeight;
            content.style.height = '0';

            setTimeout(() => {
              details.removeAttribute('open');
              content.style.height = '';
              isAnimating = false;
            }, 200);
          } else {
            details.setAttribute('open', '');
            const targetHeight = content.scrollHeight;
            content.style.height = '0';
            content.offsetHeight;
            content.style.height = `${targetHeight}px`;

            setTimeout(() => {
              content.style.height = '';
              isAnimating = false;
            }, 200);
          }
        });
      }
    });
  }
</script>

<style>
  .repo-section {
    margin-bottom: 4rem;
  }
  .section-heading {
    font-size: 0.85rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-bottom: 1.5rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .section-heading::after {
    content: "";
    height: 1px;
    flex: 1;
    background: var(--card-border);
    opacity: 0.5;
  }
  .org-repo-group {
    margin-bottom: 2rem;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 1rem;
    box-shadow: 0 4px 6px var(--shadow-color);
    overflow: clip;
  }
  .org-repo-title {
    margin: 0;
    padding: 1rem 1.25rem;
    background: transparent;
    font-size: 1.1rem;
    color: var(--text-color);
    font-weight: 700;
    border-bottom: 1px solid var(--card-border);
    word-break: break-word;
  }

  .mobile-only {
    display: none;
  }
  .desktop-only {
    display: block;
  }

  .table-container {
    width: 100%;
  }
  table {
    width: 100%;
    min-width: 600px;
    table-layout: fixed;
    border-collapse: separate;
    border-spacing: 0;
    text-align: right;
    margin-bottom: -1px;
  }
  th.repo-name-col {
    width: 35%;
  }
  th:not(.repo-name-col) {
    width: 13%;
  }
  th, td {
    padding: 0.75rem 1rem;
    white-space: nowrap;
  }
  th {
    position: sticky;
    top: var(--header-height);
    z-index: 10;
    font-size: 0.75rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
    background: var(--card-bg);
    box-shadow: inset 0 -1px 0 var(--card-border);
  }
  td {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    border-bottom: 1px solid var(--card-border);
    color: var(--text-color);
    transition: background 0.15s;
  }
  tbody tr:last-child td {
    border-bottom: none;
  }

  .repo-row {
    position: relative;
  }
  .repo-row:hover td {
    background: var(--hover-bg);
  }
  .repo-link {
    color: inherit;
    text-decoration: none;
    font-weight: inherit;
  }
  .repo-link::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .repo-row:hover .repo-link {
    color: var(--accent-color);
  }
  .repo-name-col {
    text-align: left;
    font-family: var(--font-sans);
    color: var(--text-color);
    font-weight: 600;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .stat-highlight {
    color: var(--accent-color);
    font-weight: 600;
  }

  .repo-accordion {
    border-bottom: 1px solid var(--card-border);
  }
  .repo-accordion:last-child {
    border-bottom: none;
  }
  .repo-summary {
    display: flex;
    align-items: center;
    padding: 1rem 1.25rem;
    cursor: pointer;
    user-select: none;
    list-style: none;
    background: var(--card-bg);
    transition: background 0.15s;
  }
  .repo-summary::-webkit-details-marker {
    display: none;
  }
  .repo-summary:hover {
    background: var(--hover-bg);
  }
  .repo-name-mobile {
    flex: 1;
    font-family: var(--font-sans);
    color: var(--text-color);
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .repo-score-mobile {
    color: var(--accent-color);
    font-weight: 600;
    font-family: var(--font-mono);
    margin-right: 1rem;
  }
  .accordion-icon {
    width: 1.25rem;
    height: 1.25rem;
    color: var(--text-muted);
    transition: transform 0.2s ease;
  }
  .repo-accordion[open] .accordion-icon {
    transform: rotate(180deg);
  }
  .repo-details-wrapper {
    overflow: hidden;
    transition: height 0.2s ease;
  }
  .repo-details {
    padding: 1rem 1.25rem;
    background: var(--hover-bg);
    border-top: 1px solid var(--card-border);
  }
  .stat-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin-bottom: 1.25rem;
  }
  .stat-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .stat-label {
    font-size: 0.75rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
  }
  .stat-value {
    font-family: var(--font-mono);
    color: var(--text-color);
    font-size: 0.95rem;
  }
  .repo-action-button {
    display: block;
    width: 100%;
    text-align: center;
    padding: 0.75rem;
    background: transparent;
    border: 1px solid var(--accent-color);
    color: var(--accent-color);
    border-radius: 0.5rem;
    text-decoration: none;
    font-weight: 600;
    font-family: var(--font-sans);
    transition: all 0.15s;
    box-sizing: border-box;
  }
  .repo-action-button:hover {
    background: var(--accent-color);
    color: var(--card-bg);
  }

  @media (min-width: 640px) {
    .org-repo-title {
      padding: 1.25rem 1.5rem;
    }
    th, td {
      padding: 1rem 1.5rem;
    }
  }

  @media (max-width: 1024px) {
    .mobile-only {
      display: block;
    }
    .desktop-only {
      display: none;
    }
  }
</style>
