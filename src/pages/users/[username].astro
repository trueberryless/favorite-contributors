---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import ProfileHeader from "../../components/users/ProfileHeader.astro";
import GlobalStats from "../../components/users/GlobalStats.astro";
import OrgStats from "../../components/users/OrganisationStats.astro";
import RepoStats from "../../components/users/RepositoryStats.astro";
import type { Contributor } from "../../schema";

export async function getStaticPaths() {
  const contributors: { data: Contributor }[] = await getCollection("contributors");

  const ranked = [...contributors].sort(
    (a, b) => b.data.aggregatedStats.score - a.data.aggregatedStats.score
  );

  return ranked.map((contributor, index) => ({
    params: { username: contributor.data.username },
    props: { contributor: contributor.data, rank: index + 1 },
  }));
}

export interface Props {
  contributor: Contributor;
  rank: number;
}

const { contributor, rank } = Astro.props;
const { aggregatedStats, orgStats, repoStats } = contributor;
---

<Layout title={`${contributor.username} - Contributor Profile`}>
  <main class="profile-container">
    <ProfileHeader
      username={contributor.username}
      rank={rank}
      lastUpdated={contributor.lastUpdated}
    />

    <GlobalStats aggregatedStats={aggregatedStats} />

    {Object.keys(orgStats).length > 0 && (
      <OrgStats orgStats={orgStats} />
    )}

    {Object.keys(repoStats).length > 0 && (
      <RepoStats repoStats={repoStats} />
    )}
  </main>
</Layout>

<style>
  .profile-container {
    max-width: 1000px;
    width: 100%;
    margin: 0 auto;
    padding: 1.5rem 1rem;
  }

  @media (min-width: 768px) {
    .profile-container {
      padding: 3rem 1.5rem;
    }
  }
</style>
