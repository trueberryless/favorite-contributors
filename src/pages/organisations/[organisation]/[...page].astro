---
import type { GetStaticPaths, Page } from "astro";
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import OrganisationHeader from "../../../components/organisations/OrganisationHeader.astro";
import Leaderboard from "../../../components/Leaderboard.astro";
import type { Organisation } from "../../../schema";

export const getStaticPaths = (async ({ paginate }) => {
  const organisations: { data: Organisation }[] = await getCollection("organisations");

  return organisations.flatMap((organisation) => {
    const contributors = Object.entries(organisation.data.stats)
      .map(([username, stats]: [string, any]) => ({
        username,
        stats: {
          score: stats.score || 0,
          mergedPrs: stats.mergedPrs || 0,
          reviews: stats.reviews || 0,
          reviewsReceived: stats.reviewsReceived || 0,
          issuesLinked: stats.issuesLinked || 0,
          reactions: stats.reactions || 0,
        },
      }))
      .sort((a, b) => b.stats.score - a.stats.score);

    const paginatedPaths = paginate(contributors, {
      params: { organisation: organisation.data.id },
      props: {
        organisationData: organisation.data,
        totalContributors: contributors.length
      },
      pageSize: 50,
    });

    return paginatedPaths.map((path) => ({
      ...path,
      cacheKey: String(organisation.data.updatedAt),
    }));
  });
}) satisfies GetStaticPaths;

const { page, organisationData, totalContributors } = Astro.props;
const organisationId = Astro.params.organisation;
---

<Layout title={`${organisationId} - Organisation Leaderboard`}>
  <main class="organisation-container">
    <OrganisationHeader
      organisationName={organisationId}
      lastUpdated={organisationData.updatedAt}
      totalContributors={totalContributors}
    />
    <section class="fade-in" style="animation-delay: 100ms;">
      <div class="section-heading">Organisation Leaderboard</div>
      <Leaderboard page={page} />
    </section>
  </main>

</Layout>

<style>
  .organisation-container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }
  .section-heading {
    font-size: 0.85rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-bottom: 1.5rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .section-heading::after {
    content: "";
    height: 1px;
    flex: 1;
    background: var(--card-border);
    opacity: 0.5;
  }
</style>
